# .cmd/.ps1 必须是 CRLF（cmd.exe 与 Windows PowerShell 5.1 都按行处理）
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 其余按 LF 存
*.js   text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.json text eol=lf
*.svg  text eol=lf

# 图标是二进制，别让 git 碰它的换行
*.ico binary
*.png binary
ui/app.html text eol=lf

# 第三方设计 token：保持与上游逐字节一致（LF）
third_party/dsh-theme/*.css text eol=lf
third_party/dsh-theme/LICENSE text eol=lf
.gitattributes text eol=lf
